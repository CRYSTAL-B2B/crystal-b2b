# Cloudflare Turnstile site key for the contact form widget. Public/client-side —
# safe to commit empty, but the real value must be set before deploy (baked into
# the client bundle at build time, so a rebuild is required after changing it).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Image-to-video generation only. Keep the real key in .env.local or secret storage.
EMPIRIOLABS_API_KEY=

# Public, immutable URLs for the approved WebP first frames.
SEEDANCE_IMAGE_BASE_URL=https://crystal-b2b.duckdns.org/media/first-frames

# Prompt set. It affects local files only and is safe to version-control.
SEEDANCE_PROMPT_PROFILE=seedance-2.5

# Seedance 2.5 on EmpirioLabs. Review one 720p draft per scene before a
# selected final render; this model's current API output ceiling is 720p.
SEEDANCE_MODEL=seedance-2-5
SEEDANCE_RESOLUTION=720p
SEEDANCE_DURATION=6

# Leave adaptive for image-to-video: Seedance 2.5 follows the supplied first
# frame's ratio. First/last-frame jobs require both source frames to match.
SEEDANCE_ASPECT_RATIO=adaptive
