# Static export for GitHub Pages — every variable here is public/client-side
# by necessity (baked into the build, visible in the page source and network
# tab). There is no server, so nothing here is a secret.

# Cloudflare Turnstile site key for the contact form widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# n8n webhook the contact form posts to directly from the browser (no server
# proxy in this build). Same workflow crystal-b2b already uses.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Yandex.Metrika counter id. Leave empty in dev so localhost traffic never
# gets tracked — the counter only renders in RootLayout when this is set.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Google Appointment Schedule - расписание для записи на созвон.
# Вставить адрес вида
#   https://calendar.google.com/calendar/appointments/schedules/AcZssZ.../
# Пока значение пусто, блок записи на сайте не появляется.
NEXT_PUBLIC_GOOGLE_APPOINTMENT_URL=
